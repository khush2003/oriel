<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dependency verification, scoped to what JitPack serves. JitPack builds artifacts from GitHub
  tags on demand, so unlike Maven Central and Google Maven a published version can change under
  us; these checksums pin the exact files. Everything else is trusted (pinned versions from
  repositories that don't allow republishing), so Dependabot bumps of those still pass.
  Bumping InnerTubeX: update the checksums below to the new files, after checking them, or see
  docs/RELEASING.md.
-->
<verification-metadata xmlns="https://schema.gradle.org/dependency-verification" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://schema.gradle.org/dependency-verification https://schema.gradle.org/dependency-verification/dependency-verification-1.4.xsd">
   <configuration>
      <verify-metadata>true</verify-metadata>
      <verify-signatures>false</verify-signatures>
      <trusted-artifacts>
         <trust file=".*-(sources|javadoc)[.]jar" regex="true"/>
         <trust group="^(?!com[.]github[.]).*$" regex="true"/>
      </trusted-artifacts>
   </configuration>
