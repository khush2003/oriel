<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a backup or a device-to-device transfer: the library, settings and
     the sign-in cookie stay where they are (see PRIVACY.md). allowBackup="false" alone doesn't stop
     device transfer on Android 12 and up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
