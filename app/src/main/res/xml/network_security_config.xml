<?xml version="1.0" encoding="utf-8"?>
<!-- Everything Oriel talks to is HTTPS, and only the system's certificate authorities are trusted:
     a CA the user (or a profile, or malware) installed can't read the sign-in cookie in transit. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
